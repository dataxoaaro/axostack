#!/usr/bin/env bash
# Warn when the installed skills no longer match this checkout.
#
# Enable per clone:
#
#   git config core.hooksPath scripts/hooks
#
# Warns, never blocks. Install drift says your local agent is running stale
# skills; it says nothing about whether this push is safe, and a gate that
# blocks for an unrelated reason is a gate people turn off.
#
# This cannot run in CI. A CI runner has no install directory, so every skill
# reports missing and the check fails for the wrong reason.

set -uo pipefail

root="$(git rev-parse --show-toplevel)"
[ -x "$root/scripts/sync-skills.sh" ] || exit 0

if ! "$root/scripts/sync-skills.sh" --check >/dev/null 2>&1; then
	echo "warning: your installed skills differ from this checkout." >&2
	"$root/scripts/sync-skills.sh" --check >&2 || true
	echo "warning: run scripts/sync-skills.sh to catch the running agent up." >&2
fi

exit 0
